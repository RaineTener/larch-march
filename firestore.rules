rules_version = '2';

// Larch March ride board + bagel orders.
// Anyone with the link can read and write, but only data shaped like the site's own writes is accepted.
service cloud.firestore {
  match /databases/{database}/documents {

    function validCar(d) {
      return d.keys().hasOnly(['driver', 'seats', 'leave', 'from', 'hike', 'riders', 'created'])
        && d.driver is string && d.driver.size() > 0 && d.driver.size() <= 40
        && d.seats is int && d.seats >= 1 && d.seats <= 7
        && d.leave is string && d.leave.size() <= 8
        && d.from is string && d.from.size() <= 40
        && d.hike in ['yes', 'no']
        && d.riders is list && d.riders.size() <= d.seats
        && d.created is number;
    }

    match /cars/{id} {
      allow read: if true;
      allow create, update: if validCar(request.resource.data);
      allow delete: if true;
    }

    // One doc per person on the board (driver or rider), keyed by their normalized name.
    // The site writes these inside transactions so nobody can be on two cars.
    match /riders/{key} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['car', 'name', 'driver'])
        && request.resource.data.car is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      allow update: if false;
      allow delete: if true;
    }

    match /needs/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'created'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.created is number;
      allow update: if false;
      allow delete: if true;
    }

    // Bagel orders close Friday Oct 9, 2026 at 9:00 AM Pacific (= 16:00 UTC). After that nobody can add or remove orders.
    function bagelsOpen() {
      return request.time < timestamp.date(2026, 10, 9) + duration.value(16, 'h');
    }

    match /bagels/{id} {
      allow read: if true;
      allow create: if bagelsOpen()
        && request.resource.data.keys().hasOnly(['name', 'bagel', 'schmear', 'qty', 'created'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.bagel is string && request.resource.data.bagel.size() <= 20
        && request.resource.data.schmear is string && request.resource.data.schmear.size() <= 30
        && request.resource.data.qty is int && request.resource.data.qty >= 1 && request.resource.data.qty <= 2
        && request.resource.data.created is number;
      allow update: if false;
      allow delete: if bagelsOpen();
    }
  }
}
